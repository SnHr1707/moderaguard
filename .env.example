# Copy to .env and adjust. Never commit .env (it is in .gitignore).

POSTGRES_USER=moderaguard
POSTGRES_PASSWORD=moderaguard
S3_ACCESS_KEY=moderaguard
S3_SECRET_KEY=moderaguard-secret
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# mlflow = load models from the MLflow registry (normal).
# local  = load models/<task>/champion/model.joblib (no MLflow needed).
MODEL_SOURCE=mlflow

# Docker image tag for the services (Jenkins sets this to the build number)
IMAGE_TAG=local

# Producer: baseline (training-era comments) or drift (newer comments)
PRODUCER_MODE=baseline
PRODUCER_RATE=5

# On the cloud VM: the VM's address, so Kafka is reachable from outside Docker
KAFKA_EXTERNAL_HOST=localhost
# On the cloud VM, point the consumer and Airflow at the gateway on Kubernetes,
# e.g. http://<VM_IP>  (ingress). Locally leave the default.
GATEWAY_URL=http://gateway:8000

# Lets Airflow's retrain_dag start the Jenkins canary deployment (optional)
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=

# Jenkins (cloud VM): admin login and the repository it builds
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me
GIT_REPO_URL=https://github.com/your-org/moderaguard.git

# MLflow 3 only answers requests whose Host header is listed here. Add the VM's
# public IP or domain if you open MLflow in a browser from outside.
MLFLOW_ALLOWED_HOSTS=mlflow,mlflow:5000,localhost,localhost:5000,127.0.0.1:5000,10.*,172.*,192.168.*
VM_IP=
# Where the drift job pushes its metrics. Locally the Compose pushgateway; on the
# cloud VM setup-vm.sh sets this to <VM_IP>:30091 (the Pushgateway on k3s).
PUSHGATEWAY=pushgateway:9091
